{
  "name": "ritmo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.17.1"
  },
  "scripts": {
    "dev": "pnpm --filter @ritmo/client dev",
    "build": "pnpm --filter @ritmo/client build",
    "preview": "pnpm --filter @ritmo/client preview",
    "desktop:dev": "pnpm --filter @ritmo/desktop tauri dev",
    "desktop:build": "pnpm --filter @ritmo/desktop tauri build",
    "desktop:check": "pnpm --filter @ritmo/desktop tauri info",
    "mobile:sync": "pnpm --filter @ritmo/mobile sync",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
